+"""Compatibility shims between the OmniGibson release cap-x was written for and
+the one this cluster can actually run.
+
+cap-x's BEHAVIOR adapter targets the OmniGibson 3.7.2 fork bundled under
+`capx/third_party/b1k`, which only supports Isaac Sim 4.5 -- a release with no
+Blackwell support, so it cannot run on the B300 nodes here. The simulator has
+to be Isaac Sim 5.1, i.e. OmniGibson 3.9. Everything below prefers the upstream
+symbol and only steps in when 3.9 changed it.
+"""
+
+import inspect
+
+import torch as th
+
+
+# --------------------------------------------------------------------------
+# holonomic base commands
+#
+# Both releases convert a target joint configuration into a base command inside
+# `Robot.q_to_action`, but they read the base pose from different places:
+#
+#   3.7  `body_pose = self.get_position_orientation()`   -> the robot's WORLD
+#        pose, so the caller has to hand in world-frame base entries, which is
+#        what `holonomic_base_command_in_world_frame` produced.
+#   3.9  `body_pos/body_quat` come from `get_joint_positions()[base_idx]`, i.e.
+#        the base pose in the robot ROOT frame -- which is exactly what CuRobo
+#        already returns.
+#
+# So on 3.9 the conversion must NOT happen: applying it would transform the
+# command twice and steer the base to the wrong place. The call sites in the
+# adapter stay as they are and this shim becomes the identity.
+# --------------------------------------------------------------------------
+
+
+def _identity_base_command(robot, joint_pos):
+    """3.9: CuRobo's root-frame configuration is already what q_to_action wants."""
+    return joint_pos
+
+
+try:  # OmniGibson <= 3.7
+    from omnigibson.action_primitives.curobo import holonomic_base_command_in_world_frame
+except ImportError:  # OmniGibson >= 3.9
+    holonomic_base_command_in_world_frame = _identity_base_command
+
+
+def holonomic_base_pose_in_root_frame(robot):
+    """Present upstream on <= 3.7; ported here for 3.9."""
+    try:
+        from omnigibson.action_primitives.curobo import (
+            holonomic_base_pose_in_root_frame as _upstream,
+        )
+
+        return _upstream(robot)
+    except ImportError:
+        pass
+
+    import omnigibson.utils.transform_utils as T
+
+    base_pos, base_quat = robot.links[robot.base_footprint_link_name].get_position_orientation()
+    root_pos, root_quat = robot.root_link.get_position_orientation()
+    relative_pos, relative_quat = T.relative_pose_transform(base_pos, base_quat, root_pos, root_quat)
+    base_euler = T.mat2euler_intrinsic(T.quat2mat(relative_quat))
+    return th.cat((relative_pos, base_euler))
+
+
+def robot_model_name(robot, among=None):
+    """The robot's model name, as the challenge data spells it.
+
+    3.7 exposed `Robot.model_name` ("R1Pro"); 3.9 has `Robot.model`, which is
+    lower case ("r1pro"). The task instances key their presampled robot poses
+    the 3.7 way, so a plain `robot.model` misses ("KeyError: 'r1pro'"). Pass the
+    keys available and the spelling among them is returned.
+    """
+    name = getattr(robot, "model_name", None) or robot.model
+    if among is None:
+        return name
+    if name in among:
+        return name
+    folded = {str(k).lower(): k for k in among}
+    if name.lower() in folded:
+        return folded[name.lower()]
+    raise KeyError(f"robot {name!r} is not among {sorted(among)}")
+
+
+# --------------------------------------------------------------------------
+# action primitives
+#
+# cap-x's fork added a handful of planner knobs to StarterSemanticActionPrimitives
+# (`ik_only`, `ik_world_collision_check`, `attached_obj`, `attached_obj_scale`,
+# `ignore_all_obstacles`) plus `overwrite_arm`. The underlying
+# `CuRoboMotionGenerator.compute_trajectories` in 3.9 still takes every one of
+# them, so the port is plumbing, not new behaviour.
+# --------------------------------------------------------------------------
+
+
+def _stock_primitives_have_extras():
+    from omnigibson.action_primitives.starter_semantic_action_primitives import (
+        StarterSemanticActionPrimitives,
+    )
+
+    params = inspect.signature(StarterSemanticActionPrimitives._move_hand).parameters
+    return "ik_only" in params and hasattr(StarterSemanticActionPrimitives, "overwrite_arm")
+
+
+def make_action_primitives(env, robot, **kwargs):
+    """StarterSemanticActionPrimitives with the knobs cap-x's adapter passes."""
+    from omnigibson.action_primitives.starter_semantic_action_primitives import (
+        StarterSemanticActionPrimitives,
+    )
+
+    # Constructing these warms up cuRobo's motion generator, which is where the
+    # LBFGS kernel faults on Blackwell; see force_curobo_torch_lbfgs.
+    force_curobo_torch_lbfgs()
+
+    if _curobo_cuda_graphs_broken():
+        return _build_primitives_without_cuda_graphs(env, robot, **kwargs)
+
+    if _stock_primitives_have_extras():
+        return StarterSemanticActionPrimitives(env, robot, **kwargs)
+    return _PortedActionPrimitives(env, robot, **kwargs)
+
+
+def _remove_obstacles(motion_generator):
+    """Reduce the collision world to the floor plane (3.9 dropped this helper)."""
+    import omnigibson as og
+    import omnigibson.lazy as lazy
+    import omnigibson.utils.transform_utils as T
+    from omnigibson.action_primitives.curobo import CuRoboEmbodimentSelection
+
+    obstacles = {"cuboid": None, "sphere": None, "mesh": [], "cylinder": None, "capsule": None}
+    robot_transform = T.pose_inv(T.pose2mat(motion_generator.robot.root_link.get_position_orientation()))
+
+    if og.sim.floor_plane is not None:
+        try:
+            prim = og.sim.floor_plane.prim.GetChildren()[0]
+            obstacles["mesh"].append(
+                lazy.curobo.util.usd_helper.get_mesh_attrs(
+                    prim, cache=motion_generator.usd_help._xform_cache, transform=robot_transform.numpy()
+                )
+            )
+        except Exception as e:  # noqa: BLE001 -- upstream swallows this too
+            print(f"Error adding floor plane to world collision checker: {e}")
+
+    world = lazy.curobo.geom.types.WorldConfig(**obstacles).get_collision_check_world()
+    motion_generator.mg[CuRoboEmbodimentSelection.DEFAULT].update_world(world)
+
+
+def _build_ported_primitives():
+    import math
+
+    import omnigibson.action_primitives.starter_semantic_action_primitives as _ssap
+    from omnigibson.action_primitives.action_primitive_set_base import ActionPrimitiveError
+    from omnigibson.action_primitives.curobo import CuRoboEmbodimentSelection
+    from omnigibson.action_primitives.starter_semantic_action_primitives import (
+        StarterSemanticActionPrimitives,
+        indented_print,
+    )
+
+    class _Ported(StarterSemanticActionPrimitives):
+        # `arm` is a read-only property in 3.9, so the fork's `self.arm = ...`
+        # needs an instance-level override instead.
+        _arm_override = None
+
+        @property
+        def arm(self):
+            if self._arm_override is not None:
+                return self._arm_override
+            return self.robot.default_arm
+
+        def overwrite_arm(self, arm):
+            self._arm_override = self.robot.arm_names[arm]
+
+        def _plan_joint_motion(
+            self,
+            target_pos,
+            target_quat,
+            embodiment_selection=CuRoboEmbodimentSelection.DEFAULT,
+            motion_constraint=None,
+            skip_obstacle_update=False,
+            ignore_objects=None,
+            attached_obj=None,
+            attached_obj_scale=None,
+            ik_only=False,
+            ik_world_collision_check=True,
+            ignore_all_obstacles=False,
+        ):
+            # 3.9's body, with the fork's extra knobs threaded through.
+            obj_in_hand = self._get_obj_in_hand()
+            # An object whose root link carries no trimesh cannot be attached to
+            # the plan; the caller's @attached_obj is used instead.
+            attachable = obj_in_hand is not None
+            if attachable:
+                try:
+                    obj_in_hand.root_link.get_trimesh_mesh()
+                except Exception:  # noqa: BLE001
+                    attachable = False
+            if attachable:
+                attached_obj = {self.robot.eef_link_names[self.arm]: obj_in_hand.root_link}
+
+            batch = self._motion_generator.batch_size
+            target_pos = {k: th.stack([v for _ in range(batch)]) for k, v in target_pos.items()}
+            target_quat = {k: th.stack([v for _ in range(batch)]) for k, v in target_quat.items()}
+
+            if not skip_obstacle_update:
+                self._motion_generator.update_obstacles(ignore_objects=ignore_objects)
+            if ignore_all_obstacles:
+                _remove_obstacles(self._motion_generator)
+
+            successes, traj_paths = self._motion_generator.compute_trajectories(
+                target_pos=target_pos,
+                target_quat=target_quat,
+                initial_joint_pos=None,
+                is_local=False,
+                max_attempts=math.ceil(_ssap.m.MAX_PLANNING_ATTEMPTS / batch),
+                timeout=60.0,
+                ik_fail_return=_ssap.m.MAX_IK_FAILURES_BEFORE_RETURN,
+                enable_finetune_trajopt=True,
+                finetune_attempts=1,
+                return_full_result=False,
+                success_ratio=1.0 / batch,
+                attached_obj=attached_obj,
+                attached_obj_scale=attached_obj_scale,
+                motion_constraint=motion_constraint,
+                skip_obstacle_update=True,
+                ik_only=ik_only,
+                ik_world_collision_check=ik_world_collision_check,
+                emb_sel=embodiment_selection,
+            )
+
+            success_idx = th.where(successes)[0].cpu()
+            if len(success_idx) == 0:
+                raise ActionPrimitiveError(
+                    ActionPrimitiveError.Reason.PLANNING_ERROR,
+                    "There is no accessible path from where you are to the desired pose. Try again",
+                )
+
+            traj_path = traj_paths[success_idx[0]]
+            q_traj = (
+                self._motion_generator.path_to_joint_trajectory(
+                    traj_path, get_full_js=True, emb_sel=embodiment_selection
+                )
+                .cpu()
+                .float()
+            )
+            return self._motion_generator.add_linearly_interpolated_waypoints(traj=q_traj, max_inter_dist=0.01)
+
+        def _move_hand(
+            self,
+            target_pose,
+            stop_on_contact=False,
+            stop_on_ag=False,
+            motion_constraint=None,
+            low_precision=False,
+            lock_auxiliary_arm=False,
+            ignore_objects=None,
+            attached_obj=None,
+            attached_obj_scale=None,
+            ik_only=False,
+            ik_world_collision_check=True,
+            ignore_all_obstacles=False,
+            skip_obstacle_update=False,
+        ):
+            if self.debug_visual_marker is not None:
+                self.debug_visual_marker.set_position_orientation(*target_pose)
+
+            yield from self._settle_robot()
+            if not lock_auxiliary_arm:
+                target_pos = {self.robot.eef_link_names[self.arm]: target_pose[0]}
+                target_quat = {self.robot.eef_link_names[self.arm]: target_pose[1]}
+            else:
+                left_pos, left_quat = (
+                    target_pose if self.arm == "left" else self.robot.get_eef_pose(arm="left")
+                )
+                right_pos, right_quat = (
+                    target_pose if self.arm == "right" else self.robot.get_eef_pose(arm="right")
+                )
+                target_pos = {
+                    self.robot.eef_link_names["left"]: left_pos,
+                    self.robot.eef_link_names["right"]: right_pos,
+                }
+                target_quat = {
+                    self.robot.eef_link_names["left"]: left_quat,
+                    self.robot.eef_link_names["right"]: right_quat,
+                }
+
+            q_traj = self._plan_joint_motion(
+                target_pos=target_pos,
+                target_quat=target_quat,
+                embodiment_selection=CuRoboEmbodimentSelection.ARM,
+                motion_constraint=motion_constraint,
+                ignore_objects=ignore_objects,
+                attached_obj=attached_obj,
+                attached_obj_scale=attached_obj_scale,
+                ik_only=ik_only,
+                ik_world_collision_check=ik_world_collision_check,
+                ignore_all_obstacles=ignore_all_obstacles,
+                skip_obstacle_update=skip_obstacle_update,
+            )
+            indented_print(f"Plan has {len(q_traj)} steps")
+            yield from self._execute_motion_plan(
+                q_traj, stop_on_contact=stop_on_contact, stop_on_ag=stop_on_ag, low_precision=low_precision
+            )
+
+        def _navigate_to_pose(self, pose_2d, skip_obstacle_update=False, ignore_all_obstacles=False):
+            pose_3d = self._get_robot_pose_from_2d_pose(pose_2d)
+            if self.debug_visual_marker is not None:
+                self.debug_visual_marker.set_position_orientation(*pose_3d)
+            target_pos = {self.robot.base_footprint_link_name: pose_3d[0]}
+            target_quat = {self.robot.base_footprint_link_name: pose_3d[1]}
+            q_traj = self._plan_joint_motion(
+                target_pos,
+                target_quat,
+                embodiment_selection=CuRoboEmbodimentSelection.BASE,
+                skip_obstacle_update=skip_obstacle_update,
+                ignore_all_obstacles=ignore_all_obstacles,
+            )
+            yield from self._execute_motion_plan(q_traj)
+
+    return _Ported
+
+
+class _LazyPorted:
+    """Builds the subclass on first use: importing OmniGibson at module import
+    time would drag the simulator into processes that only need the shims."""
+
+    _cls = None
+
+    def __call__(self, *args, **kwargs):
+        if _LazyPorted._cls is None:
+            _LazyPorted._cls = _build_ported_primitives()
+        return _LazyPorted._cls(*args, **kwargs)
+
+
+_PortedActionPrimitives = _LazyPorted()
+
+
+# --------------------------------------------------------------------------
+# challenge data generation
+#
+# cap-x's adapter was written against the 2025 BEHAVIOR challenge: it reads
+# `2025-challenge-task-instances` and aggregates per-episode human stats itself.
+# OmniGibson 3.9 is the 2026 codebase -- `get_task_instance_path` only looks
+# under `2026-challenge-task-instances`, task ids come from `B100_task_misc.csv`,
+# and the per-task human stats are pre-aggregated in `metadata/task.jsonl`.
+# Mixing the two silently: the 2025 episode indices would not match 2026 task
+# ids, every stat list would come out empty, and the mean would divide by zero.
+# --------------------------------------------------------------------------
+
+
+def _data_path():
+    from omnigibson.macros import gm
+
+    return gm.DATA_PATH
+
+
+def load_available_tasks():
+    """The challenge's task -> scene/robot-start table.
+
+    3.9's evaluator reads this through `gello` (the teleop package, which we do
+    not install), so we read the yaml directly.
+    """
+    import os
+
+    import yaml
+
+    path = os.path.join(_data_path(), "2026-challenge-task-instances", "metadata", "available_tasks.yaml")
+    if not os.path.exists(path):
+        return {}
+    with open(path, "r") as f:
+        return yaml.load(f, Loader=yaml.FullLoader) or {}
+
+
+def prepare_controller_cfg(cfg, activity_name):
+    """Point an OmniGibson env config at @activity_name, keeping cap-x's robot.
+
+    On 3.9 the scene a task lives in comes from the challenge metadata -- the
+    tasks are spread over seven scenes, so the config's own `scene_model`
+    (Rs_int in the stock primitives config) is wrong for all but a few, and
+    the scene file lookup then returns None. The robots block is cap-x's tuned
+    controller/sensor setup and is carried over untouched.
+    """
+    try:
+        from omnigibson.eval.utils.eval_utils import generate_basic_environment_config
+    except ImportError:  # OmniGibson <= 3.7: the config already names a BehaviorTask
+        if activity_name is not None:
+            cfg["task"]["activity_name"] = activity_name
+            cfg["scene"]["load_room_types"] = None
+        return cfg
+
+    if activity_name is None:
+        activity_name = cfg["task"]["activity_name"]
+    available = load_available_tasks()
+    if activity_name not in available:
+        raise ValueError(
+            f"{activity_name} is not in the 2026 challenge task list "
+            f"({len(available)} tasks). Check the task name against "
+            "2026-challenge-task-instances/metadata/available_tasks.yaml."
+        )
+    task_cfg = available[activity_name][0]
+    new_cfg = generate_basic_environment_config(task_name=activity_name, task_cfg=task_cfg)
+    new_cfg["robots"] = cfg["robots"]
+    if "env" in cfg:
+        new_cfg["env"].update({k: v for k, v in cfg["env"].items() if k in new_cfg["env"]})
+    # cap-x loads every room so a recipe can reach anything the task needs.
+    new_cfg["scene"]["load_room_types"] = None
+    return new_cfg
+
+
+def load_human_stats(task_name):
+    """Mean human length / distance / eef displacement for @task_name."""
+    try:
+        from omnigibson.eval.utils.score_utils import load_human_stats as _upstream
+
+        return dict(_upstream(task_name))
+    except ImportError:
+        pass
+
+    # OmniGibson <= 3.7: aggregate the 2025 per-episode records ourselves.
+    import json
+    import os
+
+    from omnigibson.eval.utils.eval_utils import TASK_NAMES_TO_INDICES  # noqa: F401  (3.7 path)
+
+    keys = ("length", "distance_traveled", "left_eef_displacement", "right_eef_displacement")
+    task_idx = TASK_NAMES_TO_INDICES[task_name]
+    stats = {k: [] for k in keys}
+    with open(os.path.join(_data_path(), "2025-challenge-task-instances", "metadata", "episodes.jsonl")) as f:
+        for line in f:
+            episode = json.loads(line)
+            if episode["episode_index"] // 1e4 == task_idx:
+                for k in keys:
+                    stats[k].append(episode[k])
+    if not stats["length"]:
+        raise ValueError(f"No human episodes found for task {task_name}")
+    return {k: sum(v) / len(v) for k, v in stats.items()}
+
+
+def tro_state_path(scene_model, activity_name, tro_filename, mode="train"):
+    """Absolute path of a task instance's task-relevant-object state file."""
+    import os
+
+    from omnigibson.utils.asset_utils import get_task_instance_path
+
+    relative = f"{scene_model}_task_{activity_name}_instances/{tro_filename}-tro_state"
+    try:  # 3.9: (scene, instance_name) -> full path under the 2026 instances
+        path = get_task_instance_path(scene_model, relative, mode=mode)
+    except TypeError:  # <= 3.7: (scene) -> the scene's directory in the 2025 instances
+        scene_dir = get_task_instance_path(scene_model)
+        path = None if scene_dir is None else os.path.join(scene_dir, "json", f"{relative}.json")
+    if path is None:
+        raise FileNotFoundError(
+            f"No task instance state for {activity_name} / {tro_filename} in scene {scene_model} (mode={mode})"
+        )
+    return path
+
+
+def robot_assets_root():
+    """`omnigibson.ROBOT_ASSETS_ROOT` on <= 3.7; a dataset path on 3.9."""
+    try:
+        from omnigibson import ROBOT_ASSETS_ROOT
+
+        return ROBOT_ASSETS_ROOT
+    except ImportError:
+        from omnigibson.utils.asset_utils import get_dataset_path
+
+        return get_dataset_path("omnigibson-robot-assets")
+
+
+# --------------------------------------------------------------------------
+# cuRobo on Blackwell data-centre GPUs
+#
+# On the B300 (compute 10.3) cuRobo's hand-written LBFGS step kernel raises
+# `CUDA error: an illegal memory access was encountered` the first time the
+# motion generator warms up, which takes the whole process down. Measured, not
+# assumed: warmup succeeds with the PyTorch implementation of the same step and
+# fails with the kernel, for every embodiment and with CUDA graph capture both
+# on and off. Building the kernels natively for sm_103 (rather than sm_100 PTX
+# JIT-ed at load time) does not help either, so this is the kernel itself.
+#
+# OmniGibson 3.9.1 knows about the problem -- it prints a note and excludes
+# embodiments -- but only for compute 12.0, and its remedy does not apply here
+# anyway: every embodiment faults.
+#
+# cuRobo offers both implementations and the config yamls set `use_cuda_kernel:
+# True` explicitly, so the flag has to be forced after they are parsed. The
+# optimiser is unchanged; only its inner loop moves off the custom kernel.
+# --------------------------------------------------------------------------
+
+# Capabilities whose LBFGS kernel we do not trust. 12.0 is upstream's own
+# report (RTX 50-series); 10.3 is what we measured on this cluster.
+_CUROBO_LBFGS_KERNEL_BROKEN = {(10, 3), (12, 0)}
+
+_lbfgs_patched = False
+
+
+def force_curobo_torch_lbfgs(force=None):
+    """Move cuRobo's LBFGS step off its CUDA kernel where that kernel faults.
+
+    Args:
+        force (None or bool): None consults the GPU; True/False decides outright.
+            The env var CAPX_CUROBO_TORCH_LBFGS (0/1) overrides the GPU check.
+
+    Returns:
+        bool: whether the PyTorch path is now in force.
+    """
+    global _lbfgs_patched
+
+    import os
+
+    if force is None:
+        override = os.environ.get("CAPX_CUROBO_TORCH_LBFGS")
+        if override is not None:
+            force = override not in ("0", "false", "False", "")
+        else:
+            import torch as th
+
+            if not th.cuda.is_available():
+                return False
+            force = th.cuda.get_device_capability() in _CUROBO_LBFGS_KERNEL_BROKEN
+
+    if not force or _lbfgs_patched:
+        return _lbfgs_patched
+
+    from curobo.opt.newton.lbfgs import LBFGSOptConfig
+
+    _original_post_init = LBFGSOptConfig.__post_init__
+
+    def _post_init_without_cuda_kernel(self):
+        _original_post_init(self)
+        self.use_cuda_kernel = False
+
+    LBFGSOptConfig.__post_init__ = _post_init_without_cuda_kernel
+    _lbfgs_patched = True
+    print("[og_compat] cuRobo LBFGS: using the PyTorch step (kernel faults on this GPU)")
+    return True
+
+
+# --------------------------------------------------------------------------
+# metrics
+#
+# 3.7 drove metrics with start/step/end callbacks that took only the env and a
+# `gather_results()` at the end. 3.9 replaced them with reset / step(env,
+# action, obs, reward, terminated, truncated, info) / aggregate(env), where the
+# step arguments are the ones the environment just returned.
+# --------------------------------------------------------------------------
+
+
+def metric_reset(metric, env):
+    if hasattr(metric, "start_callback"):
+        metric.start_callback(env)
+    else:
+        metric.reset(env)
+
+
+def metric_step(metric, env, action=None, obs=None, reward=0.0, terminated=False, truncated=False, info=None):
+    if hasattr(metric, "step_callback"):
+        metric.step_callback(env)
+    else:
+        metric.step(env, action, obs, reward, terminated, truncated, info if info is not None else {})
+
+
+def metric_results(metric, env):
+    """Aggregated metrics for the trajectory so far."""
+    if hasattr(metric, "end_callback"):
+        metric.end_callback(env)
+        return metric.gather_results()
+    return metric.aggregate(env)
+
+
+# --------------------------------------------------------------------------
+# cuRobo CUDA graphs on Blackwell
+#
+# With the LBFGS kernel out of the way, planning gets as far as the particle
+# optimiser and then faults inside `torch.cuda.graphs.replay` (measured with
+# CUDA_LAUNCH_BLOCKING=1, so the traceback points at the failing call rather
+# than the next synchronisation). Warmup survives because it plans in an empty
+# world; the real scene is what breaks.
+#
+# OmniGibson builds the motion generator with `use_cuda_graph=True` and does
+# not thread the flag through StarterSemanticActionPrimitives, so the generator
+# is constructed here instead: the primitives are built with cuRobo skipped and
+# the generator attached afterwards. Same planner, no graph capture.
+# --------------------------------------------------------------------------
+
+
+def _curobo_cuda_graphs_broken():
+    import os
+
+    override = os.environ.get("CAPX_CUROBO_CUDA_GRAPHS")
+    if override is not None:
+        return override in ("0", "false", "False")
+
+    import torch as th
+
+    if not th.cuda.is_available():
+        return False
+    return th.cuda.get_device_capability() in _CUROBO_LBFGS_KERNEL_BROKEN
+
+
+def _build_primitives_without_cuda_graphs(env, robot, **kwargs):
+    from omnigibson.action_primitives.curobo import CuRoboMotionGenerator
+    from omnigibson.action_primitives.starter_semantic_action_primitives import m as _m
+
+    batch_size = kwargs.pop("curobo_batch_size", 3)
+    cls = _LazyPorted._cls or _build_ported_primitives()
+    _LazyPorted._cls = cls
+
+    primitives = cls(env, robot, skip_curobo_initilization=True, **kwargs)
+    primitives._motion_generator = CuRoboMotionGenerator(
+        robot=robot,
+        batch_size=batch_size,
+        collision_activation_distance=_m.DEFAULT_COLLISION_ACTIVATION_DISTANCE,
+        use_cuda_graph=False,
+    )
+    print("[og_compat] cuRobo: CUDA graph capture disabled (graph replay faults on this GPU)")
+    return primitives
