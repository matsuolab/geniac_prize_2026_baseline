+    def goto_pose_settled(
+        self, position: np.ndarray, quaternion_wxyz: np.ndarray, z_approach: float = 0.0, tries: int = 3
+    ) -> None:
+        """Move to a pose and make sure the arm actually arrives.
+
+        A single goto_pose drives the joint controller for a fixed number of
+        steps and returns whether or not the target was reached, so a long move
+        (a target far to the side, or low near the table) can stop short with
+        no error. This reissues the same target `tries` times, which is what
+        makes long moves complete. Use it for every leg that matters: the
+        descent onto a grasp, the lift, the travel to a placement, the release.
+
+        Args:
+            position: (3,) XYZ target in metres, world frame.
+            quaternion_wxyz: (4,) target orientation, [w, x, y, z].
+            z_approach: approach from this many metres above first (0 = none).
+            tries: how many times to reissue the target (3-4 is plenty; use 5-6
+                for a target above 0.25 m or more than 0.6 m from the base).
+        """
+        self.goto_pose(position, quaternion_wxyz, z_approach=z_approach)
+        for _ in range(max(0, tries - 1)):
+            self.goto_pose(position, quaternion_wxyz)
+
+    def point_at_object(self, object_phrase: str, camera: str = "agentview") -> np.ndarray | None:
+        """Pixel (u, v) in the agentview image of the object a phrase describes.
+
+        Asks the vision-language model that also writes the code to look at the
+        current camera image and point at the object. Unlike a text-only
+        segmenter, it resolves *where* the object is relative to others, so this
+        is the tool for phrases like "bowl on the stove", "bowl next to the
+        plate", "black bowl between the plate and the ramekin", or "the bowl in
+        the open drawer" when several similar objects are visible.
+
+        Returns None if the model could not find it. Typical use is through
+        locate_object_points(), which calls this first and segments from the
+        returned point; call it directly only to inspect where it looked.
+        """
+        url = os.environ.get("CAPX_VLM_URL")
+        model = os.environ.get("CAPX_VLM_MODEL")
+        if not url or not model:
+            return None
+        obs = self.get_observation()
+        cam = obs.get(camera) or obs.get("agentview") or obs.get("robot0_robotview")
+        if cam is None:
+            return None
+        rgb = np.asarray(cam["images"]["rgb"])
+        h, w = rgb.shape[:2]
+        buf = io.BytesIO()
+        Image.fromarray(rgb).save(buf, format="JPEG", quality=90)
+        b64 = base64.b64encode(buf.getvalue()).decode()
+        # Qwen-VL models answer in a 0-1000 normalised frame regardless of the
+        # pixel size (the first run returned y=581 for a 512-tall image), so ask
+        # for that frame explicitly and scale it back to pixels.
+        prompt = (
+            f"Find the {object_phrase} in this image. Answer with only the "
+            f"coordinates of its centre as two integers 'x,y' on a 0-1000 scale "
+            f"(x: 0 = left edge, 1000 = right edge; y: 0 = top, 1000 = bottom). "
+            f"If it is not visible, answer 'none'."
+        )
+        payload = {
+            "model": model,
+            "temperature": 0.0,
+            "max_tokens": 64,
+            "chat_template_kwargs": {"enable_thinking": False},
+            "messages": [{"role": "user", "content": [
+                {"type": "text", "text": prompt},
+                {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{b64}"}},
+            ]}],
+        }
+        try:
+            r = requests.post(f"{url.rstrip('/')}/chat/completions", json=payload, timeout=120)
+            r.raise_for_status()
+            text = r.json()["choices"][0]["message"].get("content") or ""
+        except Exception:
+            return None
+        m = re.search(r"(\d+)\s*,\s*(\d+)", text)
+        if not m:
+            print(f"[point_at_object] '{object_phrase}': no coordinates in answer {text[:80]!r}")
+            return None
+        x, y = int(m.group(1)), int(m.group(2))
+        if not (0 <= x <= 1000 and 0 <= y <= 1000):
+            print(f"[point_at_object] '{object_phrase}': answer {x},{y} outside 0-1000")
+            return None
+        u = min(w - 1, max(0, int(round(x / 1000.0 * (w - 1)))))
+        v = min(h - 1, max(0, int(round(y / 1000.0 * (h - 1)))))
+        print(f"[point_at_object] '{object_phrase}' -> norm ({x}, {y}) -> pixel ({u}, {v}) of {w}x{h}")
+        return np.array([u, v])
+
+    def locate_object_points(self, object_phrase: str, camera: str = "agentview") -> np.ndarray:
+        """Point cloud (N, 3), world frame, of one object named in natural language.
+
+        The VLM points at the object first (see point_at_object), SAM3 segments
+        from that pixel, and the mask is back-projected with the depth map.
+        Spatial phrases work and are the right way to pick one of several
+        similar objects: "bowl on the stove", "bowl next to the plate",
+        "black bowl between the plate and the ramekin". A bare "bowl" returns
+        whichever one the segmenter scores highest, which is often the wrong
+        one when the scene holds several.
+
+        `camera` selects the view: "agentview" (fixed, default) or
+        "robot0_eye_in_hand" (wrist). Use the wrist view after moving the hand
+        above the scene when the fixed camera cannot see the object -- see
+        survey_from_above().
+
+        Returns an empty (0, 3) array if nothing was found.
+        """
+        obs = self.get_observation()
+        cam = obs.get(camera) or obs.get("agentview") or obs.get("robot0_robotview")
+        if cam is None:
+            return np.zeros((0, 3))
+        rgb, depth = cam["images"]["rgb"], cam["images"]["depth"]
+        K, E = cam["intrinsics"], cam["pose_mat"]
+        masks = []
+        # A text segmenter cannot tell "the bowl on the stove" from the other
+        # bowls, so ask the VLM to point first and segment from that pixel.
+        # Text segmentation stays as the fallback.
+        pt = self.point_at_object(object_phrase, camera=camera)
+        src = "none"
+        if pt is not None:
+            try:
+                masks = self.segment_sam3_point_prompt(rgb, (float(pt[0]), float(pt[1])))
+                src = "vlm-point"
+            except Exception as e:
+                print(f"[locate_object_points] point segmentation failed: {e}")
+                masks = []
+        if not masks:
+            try:
+                masks = self.segment_sam3_text_prompt(rgb, object_phrase)
+                src = "sam3-text"
+            except Exception:
+                masks = []
+        if not masks:
+            return np.zeros((0, 3))
+        best = max(masks, key=lambda d: d.get("score", 0.0)) if isinstance(masks[0], dict) else {"mask": masks[0]}
+        out = self.mask_to_world_points(best["mask"], depth, K, E)
+        if out is not None and len(out):
+            c = np.asarray(out).mean(axis=0)
+            print(f"[locate_object_points] '{object_phrase}' via {src}: n={len(out)} centre={np.round(c, 3)}")
+        return out if out is not None and len(out) else np.zeros((0, 3))
+
+    def top_down_grasp_for(self, object_phrase: str, expected_top: float | None = None,
+                           round_object: bool = False) -> tuple[np.ndarray, np.ndarray]:
+        """Grasp pose for an upright container (carton, bottle, can, box) from above.
+
+        Returns (position, quaternion_wxyz). The height comes from the object's
+        own point cloud: 2 cm below its top face, never lower than 1 cm below
+        its centroid. That is what makes one rule work for a tall carton and a
+        flat butter box alike; grasping a fixed offset above the centroid
+        closes the fingers in the air over anything short. The orientation is
+        straight down with the fingers closing along world y.
+
+        `expected_top` (metres, the object's real top height -- e.g. can 0.076,
+        pudding box 0.027, cream cheese/butter 0.018, bbq bottle 0.107, milk /
+        juice carton 0.131, ketchup / salad-dressing bottle 0.146) lets the
+        skill reject a wrong neighbour the pointer picked and, when the fixed
+        camera cannot see the object at all (it is hidden behind a taller
+        bottle), look for it with the wrist camera from above instead.
+        `round_object=True` for cans and bottles: the fixed camera sees only
+        their near half, so the centroid sits ~0.6 radius towards +x and the
+        fingers close on the edge; this shifts it back. On success the xy of
+        the top face seen from above is used, which is centred on the object.
+
+        Typical use:
+            p, q = top_down_grasp_for("tomato sauce can", expected_top=0.076, round_object=True)
+            open_gripper(); goto_pose_settled(p + np.array([0, 0, 0.12]), q, tries=4)
+            goto_pose_settled(p, q, tries=3); close_gripper()
+            goto_pose_settled(p + np.array([0, 0, 0.25]), q, tries=3)
+        """
+        pts = self.locate_object_points(object_phrase)
+        c = top_z = None
+        if len(pts) >= 20:
+            c = pts.mean(axis=0)
+            near = pts[np.linalg.norm(pts[:, :2] - c[:2], axis=1) < 0.06]
+            top_z = float(np.percentile(near[:, 2], 95)) if len(near) >= 20 else float(c[2]) + 0.02
+            if round_object and len(near) >= 20:
+                r = 0.5 * float(np.percentile(near[:, 1], 95) - np.percentile(near[:, 1], 5))
+                c = c.copy(); c[0] -= 0.6 * min(max(r, 0.012), 0.035)
+        cam_top = top_z
+        # The fixed camera's cloud misses the neck of a tall bottle, so its top
+        # can be up to 7 cm short of the real one; accept that range.
+        cam_ok = c is not None and (expected_top is None or -0.08 <= top_z - expected_top <= 0.02)
+        if expected_top is not None:
+            r = self.survey_from_above(object_phrase, expected_top=expected_top)
+            if r is not None:
+                cxy, top = r
+                # The view from above sees every object unoccluded, so when
+                # the two views name different objects it wins.
+                c = np.array([cxy[0], cxy[1], (c[2] if c is not None else top - 0.03)])
+                top_z = top if cam_top is None else cam_top
+                cam_ok = True
+        if c is None or not cam_ok:
+            raise RuntimeError(
+                f"could not locate '{object_phrase}'. Try a different phrase, "
+                "or survey_from_above() with another wording.")
+        grasp_z = max(top_z - 0.02, float(c[2]) - 0.01)
+        return np.array([c[0], c[1], grasp_z]), np.array([0.0, 1.0, 0.0, 0.0])
+
+    def bowl_rim_grasp_for(self, bowl_phrase: str, side="auto", near_phrase: str | None = None,
+                           plate_phrase: str = "white plate") -> tuple[np.ndarray, np.ndarray]:
+        """Grasp pose on the rim of a bowl that is wider than the gripper opens.
+
+        A bowl cannot be straddled, so close on its rim: one finger inside, one
+        outside. With the straight-down orientation the fingers close along
+        world y, so the grasp point sits on the bowl's +y or -y rim (`side`),
+        where the wall runs along x and lands between the fingers; a rim point
+        on the x side puts the wall parallel to the fingers and they slide off.
+        Height is 1 cm below the rim, measured from the cloud. Only the top of
+        a bowl is visible, so the radius is the akita bowl's real 5.5 cm, not
+        the cloud's extent.
+
+        Leave `side` at its default of -1.0 (the -y rim) for a bowl standing on
+        the table. Use +1.0 when the bowl stands at y < 0.03 with x between
+        0.50 and 0.88: the cabinet occupies y < -0.13 there and the 20 cm wide
+        hand runs into it on the -y rim, so the descent stalls and nothing is
+        grasped (that was every failure on "bowl next to the cookie box" and
+        "bowl on plate" in the goal scene). Also +1.0 when anything else sits
+        against the -y side (an open drawer, another object).
+
+        Typical use:
+            p, q = bowl_rim_grasp_for("black bowl next to the ramekin", near_phrase="small white ramekin cup")
+            open_gripper(); goto_pose_settled(p + np.array([0, 0, 0.12]), q, tries=4)
+            goto_pose_settled(p, q, tries=3); close_gripper()
+            goto_pose_settled(p + np.array([0, 0, 0.25]), q, tries=3)
+            place = bowl_place_pose_on("white plate")          # reuses the side chosen above
+
+        The grasp point is on the rim, so while the bowl is held its centre is
+        5.5 cm away from the gripper on the opposite side (+y for side=-1.0).
+        The task is judged on where the bowl's centre lands, not the gripper:
+        release it with `bowl_place_pose_on(...)`, not `place_pose_on_top_of`.
+
+        `side` may also be "-x": the hand is turned a quarter turn (fingers
+        closing along x) and the -x rim, the one nearest the robot, is taken.
+        That is the grasp for a bowl on the cabinet top, for a bowl boxed in
+        on both y sides, and whenever the plate stands beyond x = 0.75: a bowl
+        hanging on the y side of the fingers would need the hand at x ~ 0.82
+        to be released over such a plate, past the arm's reach, whereas held
+        by its -x rim it hangs towards +x and the hand stays at ~0.75.
+        `side="auto"` (default) picks -1.0, +1.0 or "-x" from the cabinet's
+        position, the plate's position (`plate_phrase`) and the bowl's height,
+        and prints its choice; pass that same value to bowl_place_pose_on.
+
+        `near_phrase` names the object the task says the bowl is next to
+        ("small white ramekin cup", "cookie box"). The pointer often returns
+        the other bowl for "bowl next to the ramekin"; with `near_phrase` the
+        skill checks the distance to that object and, if it is more than
+        18 cm, tries other wordings and keeps the candidate nearest to it.
+            open_gripper(); goto_pose_settled(p, q, z_approach=0.12, tries=4); close_gripper()
+            goto_pose_settled(p + np.array([0, 0, 0.25]), q, tries=3)
+        """
+        pts = self.locate_object_points(bowl_phrase)
+        if len(pts) < 20:
+            raise RuntimeError(
+                f"could not locate '{bowl_phrase}'. Name the bowl by where it "
+                "is, e.g. 'bowl on the stove'; a bare 'bowl' often misses." )
+        pts = pts[pts[:, 2] > float(np.percentile(pts[:, 2], 20))]
+        c = pts[:, :2].mean(axis=0)
+        rim_z = float(np.percentile(pts[:, 2], 90))
+        if near_phrase:
+            apts = self.locate_object_points(near_phrase)
+            if len(apts) >= 10:
+                a = apts[:, :2].mean(axis=0)
+                best = (float(np.linalg.norm(c - a)), c, rim_z)
+                if best[0] > 0.18:
+                    for alt in ("black bowl", f"the other black bowl, the one beside the {near_phrase}",
+                                f"black bowl closest to the {near_phrase}"):
+                        q = self.locate_object_points(alt)
+                        if len(q) < 20:
+                            continue
+                        q = q[q[:, 2] > float(np.percentile(q[:, 2], 20))]
+                        cq = q[:, :2].mean(axis=0); dq = float(np.linalg.norm(cq - a))
+                        if dq < best[0]:
+                            best = (dq, cq, float(np.percentile(q[:, 2], 90)))
+                    print(f"[bowl_rim_grasp_for] nearest to '{near_phrase}': {np.round(best[1], 3)} ({best[0]:.2f} m)")
+                    _, c, rim_z = best
+        self._last_bowl_side = side
+        if side == "auto":
+            side = -1.0
+            plate = self.locate_object_points(plate_phrase)
+            far_plate = len(plate) >= 20 and float(plate[:, 0].mean()) > 0.75
+            cab = self.locate_object_points("wooden cabinet")
+            if len(cab) >= 20 and rim_z < 0.15:
+                cx, cy = float(cab[:, 0].mean()), float(cab[:, 1].mean())
+                def hits(gy):
+                    return (abs(c[0] - cx) < 0.18) and (gy - 0.10 < cy + 0.15) and (gy + 0.10 > cy - 0.15)
+                if hits(c[1] - 0.055):
+                    side = 1.0 if not hits(c[1] + 0.055) else "-x"
+            if rim_z > 0.20 or far_plate:
+                side = "-x"
+            print(f"[bowl_rim_grasp_for] side auto -> {side}")
+            self._last_bowl_side = side
+        if side == "-x":
+            r = SciRotation.from_rotvec([0.0, 0.0, np.pi / 2]) * SciRotation.from_quat([1.0, 0.0, 0.0, 0.0])
+            x, y, z, w = r.as_quat()
+            return np.array([c[0] - 0.055, c[1], rim_z - 0.01]), np.array([w, x, y, z])
+        sgn = 1.0 if float(side) >= 0 else -1.0
+        return np.array([c[0], c[1] + sgn * 0.055, rim_z - 0.01]), np.array([0.0, 1.0, 0.0, 0.0])
+
+    def bowl_place_pose_on(self, target_phrase: str, side="auto") -> np.ndarray:
+        """Gripper position that sets a rim-held bowl down centred on the target.
+
+        "Place the bowl on the plate" is checked on the bowl's centre: it has to
+        end up within 3 cm of the target's centre, resting on it. With the rim
+        grasp from `bowl_rim_grasp_for` the bowl's centre is 5.5 cm from the
+        gripper on the -side direction of y, so the gripper is offset by that
+        much the other way. The bowl is 4 cm tall and is held 1 cm below its
+        rim, so 5 cm above the target's top surface leaves the base 2 cm up:
+        low enough not to bounce off-centre, high enough not to hit the rim.
+        Pass the same `side` you gave `bowl_rim_grasp_for`, or leave it at
+        "auto" to reuse whatever side that call chose.
+
+        Typical use (after lifting the bowl):
+            place = bowl_place_pose_on("white plate", side=-1.0)
+            goto_pose_settled(place + np.array([0, 0, 0.12]), q, tries=4)
+            goto_pose_settled(place, q, tries=3)
+            open_gripper()
+            goto_pose_settled(place + np.array([0, 0, 0.20]), q, tries=3)
+        """
+        pts = self.locate_object_points(target_phrase)
+        if len(pts) < 20:
+            raise RuntimeError(f"could not locate '{target_phrase}'.")
+        c = pts.mean(axis=0)
+        top = float(np.percentile(pts[:, 2], 95))
+        if side == "auto":
+            side = getattr(self, "_last_bowl_side", -1.0)
+            if side == "auto":
+                side = -1.0
+        if side == "-x":
+            # held by its -x rim the bowl hangs ~4.5 cm towards +x of the fingers
+            pose = np.array([c[0] - 0.045, c[1], top + 0.05])
+        else:
+            sgn = 1.0 if float(side) >= 0 else -1.0
+            pose = np.array([c[0], c[1] + sgn * 0.055, top + 0.05])
+        print(f"[bowl_place_pose_on] '{target_phrase}' centre={np.round(c, 3)} top={top:.3f} -> gripper {np.round(pose, 3)}")
+        return pose
+
+    def survey_from_above(self, object_phrase: str, expected_top: float | None = None,
+                          hover: tuple[float, float, float] = (0.57, -0.09, 0.50)) -> tuple[np.ndarray, float] | None:
+        """Find an object with the wrist camera from high above the table.
+
+        On the plain LIBERO table the target often stands right behind a taller
+        bottle and the fixed camera cannot see it at all; every phrase then
+        returns a neighbour (asked for the pudding box it kept returning the
+        juice carton, top at 0.13 m instead of 0.03 m). From straight above,
+        every top face is visible. This moves the hand to `hover` pointing
+        down, points and segments in the wrist image, and back-projects it.
+
+        Returns (centre, top_z) where centre is the middle of the object's top
+        face -- exactly where a top-down grasp goes -- and top_z its height, or
+        None if nothing plausible was seen. If `expected_top` (the object's
+        known top height, metres) is given, an answer more than 3 cm off is
+        rejected, which is how a wrong neighbour is told apart.
+
+        Typical use, after the fixed camera's answer failed a height check:
+            r = survey_from_above("chocolate pudding box", expected_top=0.03)
+            if r is not None:
+                c, top = r
+                p = np.array([c[0], c[1], top - 0.02]); q = np.array([0, 1, 0, 0])
+                open_gripper(); goto_pose_settled(p + np.array([0, 0, 0.12]), q, tries=4)
+                goto_pose_settled(p, q, tries=3); close_gripper()
+        """
+        q = np.array([0.0, 1.0, 0.0, 0.0])
+        self.goto_pose_settled(np.asarray(hover, dtype=float), q, tries=2)
+        pts = self.locate_object_points(object_phrase, camera="robot0_eye_in_hand")
+        if len(pts) < 30:
+            print(f"[survey_from_above] '{object_phrase}': only {len(pts)} points")
+            return None
+        top = float(np.percentile(pts[:, 2], 95))
+        # Only the very top: a band 3 cm deep took in a side face of a tall
+        # carton and pulled the centre 1-3 cm towards the camera.
+        face = pts[pts[:, 2] > top - 0.012]
+        c = face[:, :2].mean(axis=0)
+        print(f"[survey_from_above] '{object_phrase}' centre={np.round(c, 3)} top={top:.3f}")
+        if expected_top is not None and abs(top - expected_top) > 0.03:
+            print(f"[survey_from_above] rejected: top {top:.3f} vs expected {expected_top:.3f}")
+            return None
+        return np.array([c[0], c[1]]), top
+
+    def refine_bowl_centre_from_above(self, bowl_phrase: str, centre_xy: np.ndarray, rim_z: float) -> tuple[np.ndarray, float]:
+        """Re-measure a bowl's centre and rim height from the wrist camera.
+
+        The fixed camera sees a bowl at a low angle; for one standing close to
+        the robot (x ~ 0.46) the visible cap's centroid came out 3-4 cm off,
+        more than a rim grasp forgives. From straight above the rim is a full
+        circle and its centroid is the true centre. Hovers 30 cm over the
+        first estimate, segments in the wrist view, keeps only points within
+        9 cm of the estimate (so the pointer cannot swap in the other bowl)
+        and returns (centre_xy, rim_z). Falls back to the inputs if the view
+        yields too few points.
+
+        Typical use:
+            p, q = bowl_rim_grasp_for("bowl next to the ramekin")    # first estimate
+            c, rim = refine_bowl_centre_from_above("bowl next to the ramekin", p[:2] + [0, 0.055], p[2] + 0.01)
+            p = np.array([c[0], c[1] - 0.055, rim - 0.01])
+        """
+        centre_xy = np.asarray(centre_xy, dtype=float)
+        q = np.array([0.0, 1.0, 0.0, 0.0])
+        self.goto_pose_settled(np.array([centre_xy[0], centre_xy[1], rim_z + 0.30]), q, tries=2)
+        pts = self.locate_object_points(bowl_phrase, camera="robot0_eye_in_hand")
+        if len(pts):
+            pts = pts[np.linalg.norm(pts[:, :2] - centre_xy, axis=1) < 0.09]
+        top = float(np.percentile(pts[:, 2], 95)) if len(pts) else -1.0
+        # A wrong mask (table instead of bowl) shows up as a rim far below the
+        # one measured first; keep the inputs then.
+        if len(pts) < 100 or abs(top - rim_z) > 0.02:
+            print(f"[refine_bowl_centre_from_above] kept inputs (n={len(pts)}, rim {top:.3f})")
+            return centre_xy, rim_z
+        rim = pts[pts[:, 2] > top - 0.015]
+        c = rim[:, :2].mean(axis=0)
+        print(f"[refine_bowl_centre_from_above] centre {np.round(centre_xy, 3)} -> {np.round(c, 3)}, rim_z {rim_z:.3f} -> {top:.3f}")
+        return c, top
+
+    def yaw_quat(self, psi: float) -> np.ndarray:
+        """Straight-down gripper orientation turned by `psi` radians about the vertical axis.
+
+        psi = 0 is the usual [0, 1, 0, 0] (fingers close along world y);
+        psi = pi/2 closes them along x. Two uses:
+          - grasping a rim or bar whose wall runs along y instead of x;
+          - turning a knob: close the fingers across the knob, then call
+            goto_pose_settled at the same position with yaw_quat(psi) for
+            psi = 0.35, 0.7, 1.0 in turn. The stove knob is a vertical disc
+            on a hinge and counts as "on" past 0.5 rad; pushing it sideways
+            with the fingertips stalled at ~0.25 rad, twisting it reached
+            1.0 rad every time. Grip 2 cm above the point the knob was
+            located at, so the fingers straddle the top of the disc.
+        """
+        r = SciRotation.from_rotvec([0.0, 0.0, float(psi)]) * SciRotation.from_quat([1.0, 0.0, 0.0, 0.0])
+        x, y, z, w = r.as_quat()
+        return np.array([w, x, y, z])
+
+    def open_drawer_by_handle(self, handle_phrase: str = "middle silver handle on the black cabinet",
+                              cabinet_phrase: str = "black cabinet", pull: float = 0.22) -> np.ndarray:
+        """Open a cabinet drawer by grasping its handle bar and pulling straight out.
+
+        The grasp planner finds nothing on a thin handle bar, so the grasp is
+        built directly: locate the cabinet body and the handle, take the
+        horizontal direction from body to handle as the pull axis, approach
+        head-on along that axis with the fingers closing vertically across
+        the bar, close, and pull out `pull` metres in two legs without
+        lifting. Returns the unit pull direction so a later step (putting
+        something into the open drawer) knows where the drawer now is.
+
+        Name the handle by its row and colour, e.g. "top silver handle on the
+        black cabinet" for the top drawer, "middle silver handle ..." for the
+        middle one. Ends with the gripper open, 30 cm out from the handle.
+        """
+        c_pts = self.locate_object_points(cabinet_phrase)
+        h_pts = self.locate_object_points(handle_phrase)
+        if len(c_pts) < 20 or len(h_pts) < 5:
+            raise RuntimeError("could not locate the cabinet or its handle")
+        c_pos, h_pos = c_pts.mean(axis=0), h_pts.mean(axis=0)
+        pull_dir = h_pos - c_pos; pull_dir[2] = 0.0
+        n = np.linalg.norm(pull_dir)
+        pull_dir = pull_dir / n if n > 1e-6 else np.array([1.0, 0.0, 0.0])
+        # The cabinet's cloud centroid sits on its visible front, which tilts
+        # this vector by 20-30 deg; a drawer slides along one table axis, so
+        # snap to the dominant one.
+        ax = int(np.argmax(np.abs(pull_dir[:2])))
+        snapped = np.zeros(3); snapped[ax] = np.sign(pull_dir[ax]); pull_dir = snapped
+        zc = -pull_dir; yc = np.array([0.0, 0.0, 1.0])
+        xc = np.cross(yc, zc); xc /= np.linalg.norm(xc); zc = np.cross(xc, yc)
+        qx, qy, qz, qw = SciRotation.from_matrix(np.column_stack([xc, yc, zc])).as_quat()
+        q = np.array([qw, qx, qy, qz])
+        print(f"[open_drawer_by_handle] handle {np.round(h_pos, 3)} pull_dir {np.round(pull_dir, 3)}")
+        self.open_gripper()
+        self.goto_pose_settled(h_pos + 0.12 * pull_dir, q, tries=5)
+        self.goto_pose_settled(h_pos, q, tries=4)
+        self.close_gripper()
+        self.goto_pose_settled(h_pos + 0.5 * pull * pull_dir, q, tries=3)
+        self.goto_pose_settled(h_pos + pull * pull_dir, q, tries=4)
+        self.open_gripper()
+        self.goto_pose_settled(h_pos + (pull + 0.08) * pull_dir, q, tries=3)
+        return pull_dir
+
+    def place_pose_in_container(self, container_phrase: str, grasp_above_base: float = 0.08) -> np.ndarray:
+        """Release position that drops a held object into an open container (basket).
+
+        "In the basket" is judged on the object's origin being within ~6 cm of
+        the basket's centre, and the fixed camera's basket centroid is a few
+        cm off; a drop from 20 cm then bounced objects into a back corner or
+        onto the rim. This hovers 45 cm over the container (call it while
+        holding the object -- the rim ring stays visible around it), measures
+        the rim from the wrist camera, and returns the gripper position that
+        puts the object's base 3 cm above the rim, centred.
+        `grasp_above_base` is how far above the object's base you grasped it
+        (grasp height minus table height; the table is at z = -0.013).
+
+        Typical use:
+            place = place_pose_in_container("woven basket", grasp_above_base=p[2] + 0.013)
+            goto_pose_settled(place, q, tries=4); open_gripper()
+            goto_pose_settled(place + np.array([0, 0, 0.12]), q, tries=2)
+        """
+        q = np.array([0.0, 1.0, 0.0, 0.0])
+        pts = self.locate_object_points(container_phrase)
+        if len(pts) < 20:
+            raise RuntimeError(f"could not locate '{container_phrase}'.")
+        c = pts.mean(axis=0); top = float(np.percentile(pts[:, 2], 95))
+        # The fixed camera's centroid sits on the front wall, ~5 cm towards +x
+        # of the centre; start from the corrected guess.
+        c = np.array([c[0] - 0.05, c[1], c[2]])
+        # Two looks: the fixed camera's centroid sits on the front wall, so the
+        # first look is off-centre; the second is from over the corrected
+        # centre. Points at the held object's height and right under the hand
+        # are dropped, and the rim centre comes from its extent.
+        for _ in range(2):
+            look = np.array([c[0], c[1], 0.45])
+            self.goto_pose_settled(look, q, tries=4)
+            wpts = self.locate_object_points(container_phrase, camera="robot0_eye_in_hand")
+            if len(wpts):
+                wpts = wpts[(wpts[:, 2] > 0.03) & (wpts[:, 2] < 0.20)]
+                wpts = wpts[np.linalg.norm(wpts[:, :2] - c[:2], axis=1) < 0.16]
+                wpts = wpts[np.linalg.norm(wpts[:, :2] - look[:2], axis=1) > 0.05]
+            wtop = float(np.percentile(wpts[:, 2], 95)) if len(wpts) else -1.0
+            rim = wpts[wpts[:, 2] > wtop - 0.03] if len(wpts) else wpts
+            # A few hundred rim points means one wall only and the centre
+            # drifts the wrong way; a full ring gives thousands.
+            if len(rim) < 1500:
+                print(f"[place_pose_in_container] kept previous estimate (rim n={len(rim)})")
+                break
+            top = wtop
+            cxy = 0.5 * (np.percentile(rim[:, :2], 2, axis=0) + np.percentile(rim[:, :2], 98, axis=0))
+            c = np.array([cxy[0], cxy[1], top])
+            print(f"[place_pose_in_container] refined from above: centre={np.round(c[:2], 3)} top={top:.3f}")
+        return np.array([c[0], c[1], top + grasp_above_base + 0.03])
+
+    def wine_rack_place_pose(self, rack_phrase: str = "wine rack", neck_above_base: float = 0.13) -> tuple[np.ndarray, np.ndarray]:
+        """Gripper pose that lays a neck-held wine bottle onto the rack.
+
+        "On the rack" is judged on the bottle's BASE: it has to sit in a thin
+        slab 22-27 cm up, just inside the rack's lower rail, with the bottle
+        leaning back along the rack's slanted board (62 deg from the table).
+        Dropping the bottle upright onto the rack never did that -- it fell
+        off every time. What works: hold the bottle by the neck just above
+        the shoulder (grasp 2 cm below the top the fixed camera's cloud
+        reports, i.e. top_down_grasp_for("wine bottle") -- the shoulder then
+        interlocks with the fingers; a pinch higher up the smooth neck slips),
+        lift 25 cm, then move to the pose this returns and open. The pose
+        tilts the bottle 28 deg off vertical towards -y, parallel to the
+        board, with its base on the rail: 3 cm on the +y side of the rack's
+        cloud centroid and 4 cm above it. Back out along +y and up after
+        releasing so the open fingers do not drag it off.
+
+        Returns (position, quaternion_wxyz).
+        Typical use:
+            p, q = top_down_grasp_for("wine bottle")
+            open_gripper(); goto_pose_settled(p + np.array([0, 0, 0.10]), q, tries=4)
+            goto_pose_settled(p, q, tries=3); close_gripper()
+            goto_pose_settled(p + np.array([0, 0, 0.25]), q, tries=3)
+            tcp, tq = wine_rack_place_pose("wine rack")
+            goto_pose_settled(tcp + np.array([0, 0, 0.12]), tq, tries=4)
+            goto_pose_settled(tcp, tq, tries=4); open_gripper()
+            goto_pose(tcp, tq); goto_pose(tcp, tq)
+            goto_pose_settled(tcp + np.array([0, 0.05, 0.15]), tq, tries=2)
+            goto_pose_settled(np.array([0.45, 0.0, 0.40]), q, tries=2)
+        """
+        pts = self.locate_object_points(rack_phrase)
+        if len(pts) < 20:
+            raise RuntimeError(f"could not locate '{rack_phrase}'.")
+        rack = pts.mean(axis=0)
+        base_target = np.array([rack[0], rack[1] + 0.03, rack[2] + 0.04])
+        axis = np.array([0.0, -0.462, 0.887])          # bottle axis, parallel to the board
+        z_tool = -axis                                  # tool z points down the bottle towards its base
+        y_tool = np.array([1.0, 0.0, 0.0])              # fingers close along x, across the neck
+        x_tool = np.cross(y_tool, z_tool); x_tool = x_tool / np.linalg.norm(x_tool)
+        y_tool = np.cross(z_tool, x_tool)
+        qx, qy, qz, qw = SciRotation.from_matrix(np.column_stack([x_tool, y_tool, z_tool])).as_quat()
+        tcp = base_target + neck_above_base * axis
+        print(f"[wine_rack_place_pose] rack centroid {np.round(rack, 3)} -> base target {np.round(base_target, 3)}, tcp {np.round(tcp, 3)}")
+        return tcp, np.array([qw, qx, qy, qz])
+
+    def turn_stove_knob(self, knob_phrase: str = "stove knob", angle: float = 1.0) -> float:
+        """Turn the stove on by gripping its knob and twisting the wrist.
+
+        The knob is a vertical disc (radius 3.4 cm) on a hinge about the
+        vertical axis; the stove counts as "on" past 0.5 rad. Pushing the
+        disc sideways with the fingertips stalled at ~0.25 rad (the joint
+        controller is compliant), while gripping it and yawing the wrist
+        reached 1.0 rad every time. Grips 2 cm above the point the knob was
+        located at (straddling the top of the disc, fingers closing across
+        its faces), twists in three steps to `angle`, opens, and lifts.
+        Returns the yaw reached. Nothing else to do for "turn on the stove".
+        """
+        pts = self.locate_object_points(knob_phrase)
+        if len(pts) < 10:
+            pts = self.locate_object_points("black knob on the stove")
+        if len(pts) < 10:
+            raise RuntimeError("could not locate the stove knob")
+        knob = pts.mean(axis=0)
+        grip = np.array([knob[0], knob[1], knob[2] + 0.02])
+        print(f"[turn_stove_knob] knob {np.round(knob, 3)} grip {np.round(grip, 3)}")
+        self.open_gripper()
+        self.goto_pose_settled(grip + np.array([0.0, 0.0, 0.12]), self.yaw_quat(0.0), tries=4)
+        self.goto_pose_settled(grip, self.yaw_quat(0.0), tries=3)
+        self.close_gripper()
+        psi = 0.0
+        for psi in (angle * 0.35, angle * 0.7, angle):
+            self.goto_pose_settled(grip, self.yaw_quat(psi), tries=2)
+        self.open_gripper()
+        self.goto_pose_settled(grip + np.array([0.0, 0.0, 0.12]), self.yaw_quat(psi), tries=2)
+        return psi
+
+    def place_pose_on_top_of(self, target_phrase: str, clearance: float = 0.06) -> np.ndarray:
+        """Position to release an object so it lands on top of the target.
+
+        Targets differ a lot in height (a plate is flat, a stove is a few cm
+        up, a cabinet top is ~30 cm up), so the top surface is read from the
+        target's point cloud and the release point is `clearance` above it.
+        For a target higher than ~0.15 m first rise to the release height at
+        your current xy, then travel across, then descend -- a straight
+        diagonal move stops short. For a low target go straight there; the
+        detour knocks the object out of the gripper.
+
+        Typical use:
+            place = place_pose_on_top_of("white plate", clearance=0.03)
+            if place[2] > 0.15:
+                goto_pose_settled(np.array([here[0], here[1], place[2] + 0.12]), q, tries=4)
+            goto_pose_settled(place + np.array([0, 0, 0.12]), q, tries=6)
+            goto_pose_settled(place, q, tries=4); open_gripper()
+            for _ in range(3): goto_pose(place, q)          # let it settle
+            goto_pose_settled(place + np.array([0, 0, 0.20]), q, tries=3)
+        """
+        pts = self.locate_object_points(target_phrase)
+        if len(pts) < 20:
+            raise RuntimeError(f"could not locate '{target_phrase}'.")
+        c = pts.mean(axis=0)
+        top = float(np.percentile(pts[:, 2], 95))
+        return np.array([c[0], c[1], top + clearance])
